{
  "manifest_version": 3,
  "name": "문자 관리 시스템 - 연락처·이력서 가져오기",
  "version": "1.9.0",
  "description": "내 크롬에 로그인된 알바몬으로 이력서의 연락처와 내용을 읽어 문자 관리 시스템 새 지원에 채워 줍니다. 알바몬 아이디·비밀번호는 다루지 않습니다.",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "https://*.albamon.com/*",
    "https://interview.bigbears.me/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://interview.bigbears.me/applicants/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "연락처 가져오기"
  }
}
