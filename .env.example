# 복사해서 .env 로 사용 (.env 는 git에 올리지 않음)
PORT=3000
DB_PATH=data/app.db
# 폰이 웹훅을 보낼 공개 주소. 폰은 HTTPS 만 허용(127.0.0.1 제외). 예: Cloudflare Tunnel 주소
PUBLIC_BASE_URL=https://sms.example.com
# 같은 폰에서 문자 사이 간격(ms). 통신사 제한 회피용
SEND_INTERVAL_MS=3000
# 최초 실행 시 관리자 계정 (미지정 시 admin / 랜덤 비밀번호가 콘솔에 출력됨)
ADMIN_USER=admin
ADMIN_PASSWORD=
