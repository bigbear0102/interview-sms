{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "interview-sms",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "interview-sms",
      "database_id": "c55dbe7a-beef-4598-a67f-305a4ca94305",
      "migrations_dir": "migrations"
    }
  ],
  // 운영 주소. DNS 레코드는 기존 그대로 두고 Worker 경로(route)가 요청을 가로챈다.
  "routes": [{ "pattern": "interview.bigbears.me/*", "zone_name": "bigbears.me" }],
  // 매 분 발송 큐 처리, 정각에 파기/세션 정리
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "PUBLIC_BASE_URL": "https://interview.bigbears.me",
    // SMS 게이트웨이 3rd-party API 주소. 공개 클라우드(api.sms-gate.app) 사용 중.
    // 자체 서버를 쓰면 https://<내 도메인>/api/3rdparty/v1 (그 경우 폰 앱에 서버 주소/토큰을 안내한다)
    "GATEWAY_URL": "https://api.sms-gate.app/3rdparty/v1",
    // 종단간 암호화 PBKDF2 반복 횟수. Workers 무료 플랜 CPU 한도(10ms) 때문에 낮게 둠.
    // 유료 플랜이면 75000(앱 기본값) 이상으로 올린다.
    "E2E_ITERATIONS": "10000",
    "ADMIN_USER": "admin",
    // 인증 메일 발신 주소 (BBform 과 같은 Resend 인증 도메인 mail.bigbears.me)
    "MAIL_FROM": "문자 관리 <no-reply@mail.bigbears.me>",
    // 가입 허용 이메일 도메인
    "ALLOWED_EMAIL_DOMAIN": "willvi.co.kr",
    // 인증 메일 발신 주소(예: "문자 관리 <noreply@도메인>")는 MAIL_FROM, 메일 서비스 키는 시크릿 RESEND_API_KEY. docs/ACCOUNTS.md 참고
    // 호출 1회당 최대 발송 건수 (무료 플랜 서브리퀘스트 한도 50 고려, 유료 플랜이면 올릴 수 있음)
    "SEND_BATCH": "25"
  }
  // 시크릿(wrangler secret put): ENCRYPTION_KEY, GATEWAY_PRIVATE_TOKEN
  // → deploy/cloudflare/put-secrets.mjs 로 .env 의 값을 올린다.
}
